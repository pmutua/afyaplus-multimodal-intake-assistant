# Copy this file to .env and fill in real values.
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)
#
# Not required to run the shipped app (app.py, router.py, evaluate.py, etc.)
# -- those use only local/open models, no network calls, no API key.
#
# Required ONLY for compare_api_vs_local.py, the optional script that
# calls the real OpenAI API (GPT-4o-mini vision + Whisper API) to produce
# docs/api_vs_local_comparison.md. See README "API vs local fallback".
OPENAI_API_KEY=sk-...
